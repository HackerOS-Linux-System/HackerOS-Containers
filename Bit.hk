[package]
-> name        => hco
-> version     => 2.0.0
-> description => HackerOS Containers: container manager with pods, stacks, seccomp, REST API and a colourful CLI, built on the container and colors libraries
-> authors     => ["HackerOS Team <hackeros068@gmail.com>"]
-> license     => MIT
-> repository  => https://github.com/HackerOS-Linux-System/HackerOS-Containers
-> keywords    => ["container", "oci", "pods", "seccomp", "cli"]
-> lang        => h#

[edition]
-> edition => 2026

[layout]
-> src => src

[build]
-> link => static

[default-build]
-> profile => release

[dependencies]
-> container => newest
-> colors    => newest

[commands]
-> check
--> run => bit check
--> description => Type-check every module
-> install-local
--> run => install -Dm755 cache/build/release/hco /usr/bin/hco
--> description => Install the release binary to /usr/bin
-> doctor
--> run => cache/build/release/hco doctor
--> description => Check this host with the freshly built hco

[hooks]
-> pre-build => echo "building hco (static)"
