use "bit -> container" from "ctr"
use "bit -> colors"

mod utils
mod ui
mod args
mod backend
mod db

fn lb() -> string is
    return "{"
end

fn rb() -> string is
    return "}"
end

pub fn profiles() -> [string] is
    return ["default", "strict", "no-network"]
end

fn quoted_list(items: [string]) -> string is
    let mut out: [string] = []
    let mut i: int = 0
    while i < array_len(items) is
        out = array_push(out, "\"" + items[i] + "\"")
        i += 1
    end
    return "[" + utils::join(out, ",") + "]"
end

fn denied(name: string) -> [string] is
    let base: [string] = ["kexec_load", "kexec_file_load", "reboot", "swapon", "swapoff", "init_module", "finit_module", "delete_module", "create_module", "acct", "settimeofday", "clock_settime", "clock_adjtime", "adjtimex", "pivot_root", "mount", "umount2", "bpf", "perf_event_open", "iopl", "ioperm", "quotactl", "lookup_dcookie", "nfsservctl"]
    if name == "default" is return base end
    if name == "strict" is
        return utils::join_arrays(base, ["ptrace", "process_vm_readv", "process_vm_writev", "keyctl", "add_key", "request_key", "unshare", "setns", "userfaultfd", "personality", "open_by_handle_at", "name_to_handle_at", "mknod", "mknodat"])
    end
    if name == "no-network" is
        return utils::join_arrays(base, ["socket", "connect", "accept", "accept4", "bind", "listen", "sendto", "recvfrom", "sendmsg", "recvmsg", "socketpair"])
    end
    return []
end

;; The profile as OCI JSON ("" for an unknown name).
pub fn render(name: string) -> string is
    let list: [string] = denied(name)
    if array_len(list) == 0 is return "" end
    return lb() + "\"defaultAction\":\"SCMP_ACT_ALLOW\",\"architectures\":[\"SCMP_ARCH_X86_64\",\"SCMP_ARCH_AARCH64\"],\"syscalls\":[" + lb() + "\"names\":" + quoted_list(list) + ",\"action\":\"SCMP_ACT_ERRNO\",\"errnoRet\":1" + rb() + "]" + rb() + "\n"
end

fn profile_dir(s: ctr::store::Store) -> string is
    return db::dir(s) + "/seccomp"
end

;; Path of a profile file: a user profile in the store wins over a built-in.
pub fn path_of(s: ctr::store::Store, name: string) -> string is
    let custom: string = profile_dir(s) + "/" + name + ".json"
    if file_exists(custom) is return custom end
    if file_exists(name) is return name end
    return ""
end

fn usage() -> int is
    ui::title("hco seccomp")
    ui::help_cmd("ls", "", "built-in and installed profiles")
    ui::help_cmd("show", "NAME", "print a profile as OCI JSON")
    ui::help_cmd("install", "NAME", "write a built-in profile into the store for editing")
    ui::help_cmd("run", "ID [opts]", "run a created container through runc/crun with a profile")
    ui::hint("run options: --profile NAME  --runtime runc|crun")
    return 0
end

;; Runs a created container with an OCI runtime and a seccomp profile.
fn run_oci(s: ctr::store::Store, argv: [string]) -> int is
    let p = args::parse(argv, ["--profile", "--runtime"], false)
    let id: string = backend::resolve(s, args::pos_at(p, 0))
    if id == "" is return 1 end
    let profile: string = utils::or_default(args::get(p, ["--profile"]), "default")
    let rt: string = utils::or_default(args::get(p, ["--runtime"]), utils::first_tool(["crun", "runc"]))
    if rt == "" is return ui::fail_hint("no OCI runtime found", "install crun or runc") end
    if !utils::tool_exists("jq") is return ui::fail_hint("jq is required to patch the bundle", "install jq") end
    let mut file: string = path_of(s, profile)
    if file == "" is
        let body: string = render(profile)
        if body == "" is return ui::fail("unknown profile: " + profile) end
        file = s.st_run + "/seccomp-" + profile + ".json"
        utils::write_file(file, body)
    end
    let bundle: string = ctr::container_bundle(s, id)
    if bundle == "" || !utils::is_dir(bundle) is return ui::fail("the library produced no OCI bundle for " + utils::short_id(id)) end
    let cfg: string = bundle + "/config.json"
    ui::step(1, 2, "patching " + colors::bold(cfg) + " with profile " + colors::bold(profile))
    let tmp: string = cfg + ".hco"
    let rc: int = utils::run("jq --slurpfile sc " + utils::sq(file) + " '.linux.seccomp = $sc[0]' " + utils::sq(cfg) + " > " + utils::sq(tmp) + " && mv " + utils::sq(tmp) + " " + utils::sq(cfg))
    if rc != 0 is return ui::fail("cannot patch config.json") end
    db::meta_set(s, id, "seccomp", profile)
    ui::step(2, 2, "starting with " + colors::bold(rt))
    db::event(s, "container", utils::short_id(id), "oci-run " + rt + " seccomp=" + profile)
    return utils::run(rt + " run -b " + utils::sq(bundle) + " hco-" + utils::short_id(id))
end

pub fn cmd_seccomp(s: ctr::store::Store, argv: [string]) -> int is
    if array_len(argv) == 0 is return usage() end
    let sub: string = argv[0]
    if sub == "ls" || sub == "list" is
        let mut t = ui::table(["PROFILE", "KIND", "DENIED SYSCALLS"])
        let mut i: int = 0
        while i < array_len(profiles()) is
            t = ui::add_row(t, [colors::bold(profiles()[i]), "built-in", to_string(array_len(denied(profiles()[i])))])
            i += 1
        end
        let own: [string] = utils::list_dir(profile_dir(s))
        let mut k: int = 0
        while k < array_len(own) is
            t = ui::add_row(t, [colors::bold(utils::head_before(own[k], ".json")), colors::fg::mediumpurple("installed"), ui::muted(profile_dir(s) + "/" + own[k])])
            k += 1
        end
        ui::print_table(t)
        return 0
    end
    if sub == "show" is
        if array_len(argv) != 2 is return ui::fail("usage: hco seccomp show NAME") end
        let file: string = path_of(s, argv[1])
        if file != "" is
            write(utils::read(file))
            return 0
        end
        let body: string = render(argv[1])
        if body == "" is return ui::fail("unknown profile: " + argv[1]) end
        write(body)
        return 0
    end
    if sub == "install" is
        if array_len(argv) != 2 is return ui::fail("usage: hco seccomp install NAME") end
        let body: string = render(argv[1])
        if body == "" is return ui::fail("unknown built-in profile: " + argv[1]) end
        utils::write_file(profile_dir(s) + "/" + argv[1] + ".json", body)
        ui::success("installed " + colors::bold(profile_dir(s) + "/" + argv[1] + ".json"))
        return 0
    end
    if sub == "run" is return run_oci(s, args::argv_tail(argv, 1)) end
    ui::error("unknown seccomp command: " + sub)
    return usage()
end
