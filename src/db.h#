use "bit -> container" from "ctr"

mod utils

pub fn dir(s: ctr::store::Store) -> string is
    return s.st_root + "/hco"
end

pub fn meta_path(s: ctr::store::Store, id: string) -> string is
    return dir(s) + "/meta/" + id
end

pub fn pod_path(s: ctr::store::Store, pod: string) -> string is
    return dir(s) + "/pods/" + pod
end

pub fn events_path(s: ctr::store::Store) -> string is
    return dir(s) + "/events.log"
end

;; ── Per-container metadata ───────────────────────────────────────────────────

pub fn meta_get(s: ctr::store::Store, id: string, key: string) -> string is
    return utils::kv_get(meta_path(s, id), key)
end

pub fn meta_set(s: ctr::store::Store, id: string, key: string, value: string) is
    utils::kv_set(meta_path(s, id), key, value)
end

pub fn meta_drop(s: ctr::store::Store, id: string) is
    utils::rm_rf(meta_path(s, id))
end

;; ── Pods ─────────────────────────────────────────────────────────────────────

pub fn pod_names(s: ctr::store::Store) -> [string] is
    return utils::list_dir(dir(s) + "/pods")
end

pub fn pod_exists(s: ctr::store::Store, pod: string) -> bool is
    return file_exists(pod_path(s, pod))
end

pub fn pod_get(s: ctr::store::Store, pod: string, key: string) -> string is
    return utils::kv_get(pod_path(s, pod), key)
end

pub fn pod_set(s: ctr::store::Store, pod: string, key: string, value: string) is
    utils::kv_set(pod_path(s, pod), key, value)
end

pub fn pod_drop(s: ctr::store::Store, pod: string) is
    utils::rm_rf(pod_path(s, pod))
end

;; Ids of the containers that belong to `pod` (meta pod=<name>).
pub fn pod_members(s: ctr::store::Store, pod: string) -> [string] is
    let all: [string] = utils::list_dir(dir(s) + "/meta")
    let mut out: [string] = []
    let mut i: int = 0
    while i < array_len(all) is
        if meta_get(s, all[i], "pod") == pod is out = array_push(out, all[i]) end
        i += 1
    end
    return out
end

;; ── Events ───────────────────────────────────────────────────────────────────

pub fn event(s: ctr::store::Store, kind: string, object: string, message: string) is
    utils::append_line(events_path(s), to_string(utils::now_unix()) + "|" + kind + "|" + object + "|" + message)
end

;; The last `n` events as raw lines.
pub fn events_tail(s: ctr::store::Store, n: int) -> [string] is
    if !file_exists(events_path(s)) is return [] end
    return utils::lines(utils::capture("tail -n " + to_string(n) + " " + utils::sq(events_path(s))))
end
