mod utils

;; A parsed file is a flat list of "section|key|value" entries, in file order.

fn parse_line(raw: string) -> string is
    let l: string = string_trim(raw)
    if l == "" || string_starts_with(l, "!") || string_starts_with(l, ";") is return "" end
    if string_starts_with(l, "->") is
        let body: string = string_trim(string_slice(l, 2, string_len(l)))
        let i: int = string_find(body, "=>")
        if i < 0 is return "" end
        return "kv|" + string_trim(string_slice(body, 0, i)) + "|" + string_trim(string_slice(body, i + 2, string_len(body)))
    end
    if string_starts_with(l, "[") && string_ends_with(l, "]") is
        return "sec|" + string_trim(string_slice(l, 1, string_len(l) - 1)) + "|"
    end
    let eq: int = string_find(l, "=")
    if eq > 0 is
        return "kv|" + string_trim(string_slice(l, 0, eq)) + "|" + string_trim(string_slice(l, eq + 1, string_len(l)))
    end
    return ""
end

pub fn parse(text: string) -> [string] is
    let ls: [string] = string_split(text, "\n")
    let mut section: string = ""
    let mut out: [string] = []
    let mut i: int = 0
    while i < array_len(ls) is
        let r: string = parse_line(ls[i])
        if r != "" is
            let kind: string = utils::head_before(r, "|")
            let rest: string = utils::tail_after(r, "|")
            if kind == "sec" is
                section = utils::head_before(rest, "|")
            else is
                out = array_push(out, section + "|" + utils::head_before(rest, "|") + "|" + utils::tail_after(rest, "|"))
            end
        end
        i += 1
    end
    return out
end

pub fn load(path: string) -> [string] is
    return parse(utils::read(path))
end

;; Section names in order of first appearance.
pub fn sections(entries: [string]) -> [string] is
    let mut out: [string] = []
    let mut i: int = 0
    while i < array_len(entries) is
        let sec: string = utils::head_before(entries[i], "|")
        if !utils::has(out, sec) is out = array_push(out, sec) end
        i += 1
    end
    return out
end

;; Every value of `key` in `section`.
pub fn all(entries: [string], section: string, key: string) -> [string] is
    let mut out: [string] = []
    let mut i: int = 0
    while i < array_len(entries) is
        let rest: string = utils::tail_after(entries[i], "|")
        if utils::head_before(entries[i], "|") == section && utils::head_before(rest, "|") == key is
            out = array_push(out, utils::tail_after(rest, "|"))
        end
        i += 1
    end
    return out
end

pub fn get(entries: [string], section: string, key: string) -> string is
    let v: [string] = all(entries, section, key)
    if array_len(v) == 0 is return "" end
    return v[array_len(v) - 1]
end

pub fn get_or(entries: [string], section: string, key: string, fallback: string) -> string is
    return utils::or_default(get(entries, section, key), fallback)
end

;; Global config: $HCO_CONFIG, else /etc/hco/hco.hk (missing file = no entries).
pub fn global() -> [string] is
    let p: string = utils::or_default(env_get("HCO_CONFIG"), "/etc/hco/hco.hk")
    if !file_exists(p) is return [] end
    return load(p)
end
