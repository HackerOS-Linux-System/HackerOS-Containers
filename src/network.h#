use "bit -> container" from "ctr"
use "bit -> colors"

mod utils
mod ui
mod args
mod backend
mod cni

fn usage() -> int is
    ui::title("hco network")
    ui::help_cmd("ls", "", "bridge, host, none and CNI networks")
    ui::help_cmd("inspect", "", "bridge status and addressing")
    ui::help_cmd("attach", "NET CONTAINER", "attach a running container to a CNI network")
    ui::help_cmd("detach", "NET CONTAINER", "detach it again")
    return 0
end

fn bridge_name() -> string is
    return utils::or_default(env_get("CONTAINER_BRIDGE"), "container0")
end

pub fn cmd_network(s: ctr::store::Store, argv: [string]) -> int is
    if array_len(argv) == 0 is return usage() end
    let sub: string = argv[0]
    if sub == "ls" || sub == "list" is
        let mut t = ui::table(["NETWORK", "DRIVER", "DESCRIPTION"])
        t = ui::add_row(t, [colors::bold("bridge"), "builtin", "NAT bridge " + bridge_name() + " with port publishing"])
        t = ui::add_row(t, [colors::bold("host"), "builtin", "share the host's network stack"])
        t = ui::add_row(t, [colors::bold("none"), "builtin", "loopback only"])
        let extra: [string] = cni::networks()
        let mut i: int = 0
        while i < array_len(extra) is
            t = ui::add_row(t, [colors::bold(extra[i]), colors::fg::mediumpurple("cni"), "defined in " + cni::conf_dir()])
            i += 1
        end
        ui::print_table(t)
        return 0
    end
    if sub == "inspect" is
        let up: bool = utils::quiet("ip link show " + utils::sq(bridge_name())) == 0
        ui::title("bridge " + bridge_name())
        ui::kv("Present", ui::bool_mark(up))
        if up is
            ui::kv("Address", utils::or_default(utils::capture("ip -4 -o addr show " + utils::sq(bridge_name()) + " | tr -s ' ' | cut -d' ' -f4"), "—"))
            ui::kv("Attached", utils::or_default(utils::capture("ip -o link show master " + utils::sq(bridge_name()) + " | wc -l"), "0"))
        else is
            ui::hint("the bridge is created when the first bridge-mode container starts")
        end
        ui::kv("IP forwarding", ui::bool_mark(utils::read_trim("/proc/sys/net/ipv4/ip_forward") == "1"))
        ui::kv("CNI", ui::bool_mark(cni::available()))
        return 0
    end
    if sub == "attach" || sub == "detach" is
        if array_len(argv) != 3 is return ui::fail("usage: hco network " + sub + " NETWORK CONTAINER") end
        return cni::attach(s, argv[1], argv[2], sub == "detach")
    end
    ui::error("unknown network command: " + sub)
    return usage()
end

;; hco port CONTAINER — published ports.
pub fn cmd_port(s: ctr::store::Store, argv: [string]) -> int is
    if array_len(argv) != 1 is return ui::fail("usage: hco port CONTAINER") end
    let id: string = backend::resolve(s, argv[0])
    if id == "" is return 1 end
    let ports: string = utils::kv_get(s.st_root + "/containers/" + id + "/state", "publish")
    if ports == "" is
        ui::info("no published ports")
        return 0
    end
    let specs: [string] = string_split(ports, ",")
    let mut i: int = 0
    while i < array_len(specs) is
        write("  " + colors::bold(specs[i]))
        i += 1
    end
    return 0
end
