use "bit -> container" from "ctr"
use "bit -> colors"

mod utils
mod ui
mod args
mod backend
mod db

fn cg(id: string) -> string is
    return "/sys/fs/cgroup/container/" + id
end

pub fn mem_current(id: string) -> int is
    return utils::atoi(utils::read_trim(cg(id) + "/memory.current"))
end

;; Memory limit in bytes, 0 when unlimited.
pub fn mem_limit(id: string) -> int is
    let v: string = utils::read_trim(cg(id) + "/memory.max")
    if v == "max" || v == "" is return 0 end
    return utils::atoi(v)
end

pub fn pids_current(id: string) -> int is
    return utils::atoi(utils::read_trim(cg(id) + "/pids.current"))
end

;; Total CPU time in microseconds.
pub fn cpu_usec(id: string) -> int is
    return utils::atoi(utils::capture("grep '^usage_usec' " + utils::sq(cg(id) + "/cpu.stat") + " 2>/dev/null | cut -d' ' -f2"))
end

fn pct_of(part: int, whole: int) -> int is
    if whole <= 0 is return 0 end
    return (part * 100) / whole
end

;; hco stats [-w] [CONTAINER...]   (one-second CPU sample; -w keeps refreshing)
pub fn cmd_stats(s: ctr::store::Store, argv: [string]) -> int is
    let p = args::parse(argv, [], false)
    let mut ids: [string] = []
    let named: [string] = args::pos(p)
    if array_len(named) == 0 is
        ids = backend::ids(s, true)
    else is
        let mut i: int = 0
        while i < array_len(named) is
            let id: string = backend::resolve(s, named[i])
            if id == "" is return 1 end
            ids = array_push(ids, id)
            i += 1
        end
    end
    if array_len(ids) == 0 is
        ui::info("no running containers")
        return 0
    end
    if ctr::host_info().hi_cgroup != 2 is
        ui::warn("cgroup v1 host: only memory figures are available")
    end
    let watch: bool = args::flag(p, ["-w", "--watch"])
    let mut round: int = 0
    while true is
        let mut before: [int] = []
        let mut k: int = 0
        while k < array_len(ids) is
            before = array_push(before, cpu_usec(ids[k]))
            k += 1
        end
        let t0: int = utils::now_ms()
        sleep_ms(1000)
        let dt: int = utils::max_int((utils::now_ms() - t0) * 1000, 1)
        let mut t = ui::table(["NAME", "CPU", "MEMORY", "USED / LIMIT", "PIDS"])
        let mut j: int = 0
        while j < array_len(ids) is
            let cpu: int = pct_of(cpu_usec(ids[j]) - before[j], dt)
            let mem: int = mem_current(ids[j])
            let lim: int = mem_limit(ids[j])
            let host_mem: int = utils::atoi(utils::capture("grep '^MemTotal' /proc/meminfo | tr -s ' ' | cut -d' ' -f2")) * 1024
            let scale: int = if lim > 0 then lim else host_mem end
            t = ui::add_row(t, [colors::bold(backend::name_of(s, ids[j])), ui::usage_bar(cpu, 14), ui::usage_bar(pct_of(mem, scale), 14), utils::human_bytes(mem) + " / " + if lim > 0 then utils::human_bytes(lim) else "∞" end, to_string(pids_current(ids[j]))])
            j += 1
        end
        if watch && round > 0 is utils::quiet("printf '\\033[2J\\033[H'") end
        if watch is utils::run("printf '\\033[2J\\033[H'") end
        ui::print_table(t)
        round += 1
        if !watch is break end
    end
    return 0
end

;; hco top CONTAINER — processes inside the container's cgroup.
pub fn cmd_top(s: ctr::store::Store, argv: [string]) -> int is
    if array_len(argv) != 1 is return ui::fail("usage: hco top CONTAINER") end
    let id: string = backend::resolve(s, argv[0])
    if id == "" is return 1 end
    if !backend::is_running(s, id) is return ui::fail("container is not running") end
    let pids: string = utils::capture("cat " + utils::sq(cg(id) + "/cgroup.procs") + " 2>/dev/null | tr '\\n' ',' | sed 's/,$//'")
    if pids == "" is return ui::fail("cannot read the container's cgroup (is the host cgroup v2?)") end
    ui::title("processes of " + backend::name_of(s, id))
    write(utils::capture("ps -o pid=PID,ppid=PPID,user=USER,pcpu=%CPU,pmem=%MEM,etime=TIME,args=COMMAND -p " + pids))
    return 0
end

;; ── Prometheus ───────────────────────────────────────────────────────────────

fn lb() -> string is
    return "{"
end

fn rb() -> string is
    return "}"
end

fn label(v: string) -> string is
    return string_replace(string_replace(v, "\\", "\\\\"), "\"", "\\\"")
end

;; Prometheus text format, version 0.0.4.
pub fn prometheus(s: ctr::store::Store) -> string is
    let all: [ctr::runtime::ContainerInfo] = ctr::container_list(s)
    let mut out: [string] = []
    out = array_push(out, "# HELP hco_containers Number of containers by state.")
    out = array_push(out, "# TYPE hco_containers gauge")
    let mut running: int = 0
    let mut i: int = 0
    while i < array_len(all) is
        if all[i].ci_status == "running" is running += 1 end
        i += 1
    end
    out = array_push(out, "hco_containers" + lb() + "state=\"running\"" + rb() + " " + to_string(running))
    out = array_push(out, "hco_containers" + lb() + "state=\"total\"" + rb() + " " + to_string(array_len(all)))
    out = array_push(out, "# HELP hco_images Number of images in the store.")
    out = array_push(out, "# TYPE hco_images gauge")
    out = array_push(out, "hco_images " + to_string(array_len(ctr::image_list(s))))
    out = array_push(out, "# HELP hco_container_up 1 when the container is running.")
    out = array_push(out, "# TYPE hco_container_up gauge")
    out = array_push(out, "# HELP hco_container_memory_bytes Memory used by the container.")
    out = array_push(out, "# TYPE hco_container_memory_bytes gauge")
    out = array_push(out, "# HELP hco_container_cpu_seconds_total CPU time used by the container.")
    out = array_push(out, "# TYPE hco_container_cpu_seconds_total counter")
    out = array_push(out, "# HELP hco_container_pids Processes in the container.")
    out = array_push(out, "# TYPE hco_container_pids gauge")
    let mut k: int = 0
    while k < array_len(all) is
        let c: ctr::runtime::ContainerInfo = all[k]
        let lbl: string = lb() + "id=\"" + utils::short_id(c.ci_id) + "\",name=\"" + label(c.ci_name) + "\",image=\"" + label(c.ci_image) + "\"" + rb()
        out = array_push(out, "hco_container_up" + lbl + " " + if c.ci_status == "running" then "1" else "0" end)
        if c.ci_status == "running" is
            out = array_push(out, "hco_container_memory_bytes" + lbl + " " + to_string(mem_current(c.ci_id)))
            out = array_push(out, "hco_container_cpu_seconds_total" + lbl + " " + to_string(cpu_usec(c.ci_id) / 1000000))
            out = array_push(out, "hco_container_pids" + lbl + " " + to_string(pids_current(c.ci_id)))
        end
        k += 1
    end
    return utils::join(out, "\n") + "\n"
end

pub fn cmd_metrics(s: ctr::store::Store) -> int is
    ui::out(prometheus(s))
    return 0
end
