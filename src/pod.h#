use "bit -> container" from "ctr"
use "bit -> colors"

mod utils
mod ui
mod args
mod backend
mod db
mod validation
mod sandbox

fn usage() -> int is
    ui::title("hco pod")
    ui::help_cmd("create", "NAME [opts]", "new pod (--network --memory --cpus --restart --preset)")
    ui::help_cmd("ls", "", "list pods")
    ui::help_cmd("inspect", "NAME", "show pod defaults and members")
    ui::help_cmd("start", "NAME", "start every member")
    ui::help_cmd("stop", "NAME", "stop every member")
    ui::help_cmd("restart", "NAME", "restart every member")
    ui::help_cmd("rm", "NAME [-f]", "remove the pod (-f also removes members)")
    ui::hint("run a member with: hco run --pod NAME IMAGE")
    return 0
end

fn create(s: ctr::store::Store, argv: [string]) -> int is
    let p = args::parse(argv, ["--network", "--memory", "--cpus", "--restart", "--preset"], false)
    let name: string = args::pos_at(p, 0)
    let bad: string = validation::name(name)
    if bad != "" is return ui::fail("pod name: " + bad) end
    if db::pod_exists(s, name) is return ui::fail("pod " + name + " already exists") end
    let net: string = args::get(p, ["--network"])
    if net != "" && validation::network_mode(net) != "" is return ui::fail(validation::network_mode(net)) end
    let mem: string = args::get(p, ["--memory"])
    if mem != "" && validation::memory(mem) != "" is return ui::fail(validation::memory(mem)) end
    let pol: string = args::get(p, ["--restart"])
    if pol != "" && validation::restart_policy(pol) != "" is return ui::fail(validation::restart_policy(pol)) end
    let pre: string = args::get(p, ["--preset"])
    if pre != "" && !sandbox::known(pre) is return ui::fail("unknown preset " + pre) end
    db::pod_set(s, name, "created", to_string(utils::now_unix()))
    if net != "" is db::pod_set(s, name, "network", net) end
    if mem != "" is db::pod_set(s, name, "memory", mem) end
    if args::get(p, ["--cpus"]) != "" is db::pod_set(s, name, "cpus", args::get(p, ["--cpus"])) end
    if pol != "" is db::pod_set(s, name, "restart", pol) end
    if pre != "" is db::pod_set(s, name, "preset", pre) end
    db::event(s, "pod", name, "create")
    ui::success("pod " + colors::bold(name) + " created")
    ui::hint("add containers with: hco run -d --pod " + name + " IMAGE")
    return 0
end

fn ls(s: ctr::store::Store) -> int is
    let pods: [string] = db::pod_names(s)
    if array_len(pods) == 0 is
        ui::info("no pods")
        ui::hint("create one with: hco pod create NAME")
        return 0
    end
    let mut t = ui::table(["POD", "CONTAINERS", "RUNNING", "NETWORK", "MEMORY", "RESTART", "PRESET"])
    let mut i: int = 0
    while i < array_len(pods) is
        let m: [string] = db::pod_members(s, pods[i])
        let mut up: int = 0
        let mut k: int = 0
        while k < array_len(m) is
            if backend::is_running(s, m[k]) is up += 1 end
            k += 1
        end
        t = ui::add_row(t, [colors::bold(pods[i]), to_string(array_len(m)), if up > 0 then colors::fg::limegreen(to_string(up)) else ui::muted("0") end, utils::or_default(db::pod_get(s, pods[i], "network"), "bridge"), utils::or_default(db::pod_get(s, pods[i], "memory"), "—"), utils::or_default(db::pod_get(s, pods[i], "restart"), "no"), utils::or_default(db::pod_get(s, pods[i], "preset"), "—")])
        i += 1
    end
    ui::print_table(t)
    return 0
end

fn inspect(s: ctr::store::Store, name: string) -> int is
    if !db::pod_exists(s, name) is return ui::fail("no such pod: " + name) end
    ui::title("pod " + name)
    ui::kv("Network", utils::or_default(db::pod_get(s, name, "network"), "bridge"))
    ui::kv("Memory", utils::or_default(db::pod_get(s, name, "memory"), "—"))
    ui::kv("CPUs", utils::or_default(db::pod_get(s, name, "cpus"), "—"))
    ui::kv("Restart", utils::or_default(db::pod_get(s, name, "restart"), "no"))
    ui::kv("Preset", utils::or_default(db::pod_get(s, name, "preset"), "—"))
    let m: [string] = db::pod_members(s, name)
    ui::section("Members")
    if array_len(m) == 0 is
        ui::out(ui::muted("  (none)"))
        return 0
    end
    let mut i: int = 0
    while i < array_len(m) is
        write("  " + colors::util::pad_right(colors::bold(backend::name_of(s, m[i])), 24) + ui::status_badge(ctr::container_status(s, m[i])))
        i += 1
    end
    return 0
end

fn each_member(s: ctr::store::Store, name: string, act: string) -> int is
    if !db::pod_exists(s, name) is return ui::fail("no such pod: " + name) end
    let m: [string] = db::pod_members(s, name)
    if array_len(m) == 0 is
        ui::info("pod " + name + " has no containers")
        return 0
    end
    let mut failed: int = 0
    let mut i: int = 0
    while i < array_len(m) is
        let mut good: bool = false
        if act == "start" is
            good = ctr::container_start(s, m[i], false) == 0
            if good is db::meta_set(s, m[i], "user_stopped", "0") end
        else if act == "stop" is
            good = ctr::container_stop(s, m[i], 10)
            if good is db::meta_set(s, m[i], "user_stopped", "1") end
        else is
            ctr::container_stop(s, m[i], 10)
            good = ctr::container_start(s, m[i], false) == 0
        end
        if good is
            ui::success(act + " " + colors::bold(backend::name_of(s, m[i])) + " " + ui::muted("[" + name + "]"))
        else is
            ui::error("cannot " + act + " " + backend::name_of(s, m[i]))
            failed += 1
        end
        i += 1
    end
    db::event(s, "pod", name, act)
    if failed > 0 is return 1 end
    return 0
end

fn remove(s: ctr::store::Store, argv: [string]) -> int is
    let p = args::parse(argv, [], false)
    let name: string = args::pos_at(p, 0)
    if !db::pod_exists(s, name) is return ui::fail("no such pod: " + name) end
    let m: [string] = db::pod_members(s, name)
    if array_len(m) > 0 && !args::flag(p, ["-f", "--force"]) is
        return ui::fail_hint("pod " + name + " still has " + to_string(array_len(m)) + " container(s)", "use -f to remove them too")
    end
    let mut i: int = 0
    while i < array_len(m) is
        ctr::container_remove(s, m[i], true)
        db::meta_drop(s, m[i])
        i += 1
    end
    db::pod_drop(s, name)
    db::event(s, "pod", name, "remove")
    ui::success("pod " + colors::bold(name) + " removed")
    return 0
end

;; hco pod <subcommand> ...
pub fn cmd_pod(s: ctr::store::Store, argv: [string]) -> int is
    if array_len(argv) == 0 is return usage() end
    let sub: string = argv[0]
    let rest: [string] = args::argv_tail(argv, 1)
    if sub == "create" || sub == "new" is return create(s, rest) end
    if sub == "ls" || sub == "list" || sub == "ps" is return ls(s) end
    if sub == "inspect" is return inspect(s, if array_len(rest) > 0 then rest[0] else "" end) end
    if sub == "start" || sub == "stop" || sub == "restart" is
        if array_len(rest) != 1 is return ui::fail("usage: hco pod " + sub + " NAME") end
        return each_member(s, rest[0], sub)
    end
    if sub == "rm" || sub == "remove" is return remove(s, rest) end
    ui::error("unknown pod command: " + sub)
    return usage()
end
