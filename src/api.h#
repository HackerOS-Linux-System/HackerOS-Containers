fn json_response(res: http::Response, status: int, body: any) is
    http::set_status(res, status)
    http::set_header(res, "Content-Type", "application/json")
    http::write_body(res, json::stringify(body))
end

fn error_response(res: http::Response, status: int, message: string) is
    let mut body: any = json::object()
    json::set(body, "error", message)
    json_response(res, status, body)
end

fn container_to_json(c: db::ContainerRow) -> any is
    let mut body: any = json::object()
    json::set(body, "id", db::row_id(c))
    json::set(body, "name", db::row_name(c))
    json::set(body, "image", db::row_image(c))
    json::set(body, "pid", db::row_pid(c))
    json::set(body, "status", db::row_status(c))
    json::set(body, "ip_address", db::row_ip_address(c))
    json::set(body, "ports", db::row_ports(c))
    json::set(body, "pod_id", db::row_pod_id(c))
    json::set(body, "created_at", db::row_created_at(c))
    return body
end

fn pod_to_json(p: db::PodRow) -> any is
    let mut body: any = json::object()
    json::set(body, "name", db::pod_row_name(p))
    json::set(body, "container_ids", db::pod_container_ids(p))
    json::set(body, "status", db::pod_row_status(p))
    json::set(body, "shared_network", db::pod_row_shared_network(p))
    json::set(body, "created_at", db::pod_row_created_at(p))
    return body
end

;; ── handlers ──────────────────────────────────────────────────────────────────

fn handle_list_containers(req: http::Request, res: http::Response) is
    let page: int = http::query_int(req, "page", 1)
    let per_page: int = http::query_int(req, "per_page", 50)
    let result: ([db::ContainerRow], int) = container::list_containers(page, per_page)
    let mut items: [any] = []
    for c in result.0 is
        items = array_push(items, container_to_json(c))
    end
    let mut body: any = json::object()
    json::set(body, "items", items)
    json::set(body, "total", result.1)
    json::set(body, "page", page)
    json_response(res, 200, body)
end

fn handle_create_container(req: http::Request, res: http::Response) is
    let parsed: any? = json::parse(http::body_text(req))
    if parsed == nil is
        error_response(res, 400, "Invalid JSON body")
        return
    end
    let b: any = parsed
    let opts: container::CreateOptions = container::CreateOptions {
        name: json::get_string(b, "name", ""),
        image_ref: json::get_string(b, "image", ""),
        mounts: json::get_string_array(b, "mounts"),
        ports: json::get_string_array(b, "ports"),
        env: json::get_string_array(b, "env"),
        memory_limit: json::get_string(b, "memory_limit", ""),
        cpu_percent: json::get_int(b, "cpu_percent", 0),
        cni_network: json::get_string(b, "cni_network", ""),
        rootless: json::get_bool(b, "rootless", false),
        readonly_root: json::get_bool(b, "readonly_root", false),
        auto_restart: json::get_bool(b, "auto_restart", false),
        seccomp: json::get_string(b, "seccomp_profile", ""),
        pod_id: json::get_string(b, "pod_id", "")
    }
    let result: (string, container::OpError?) = container::create_container(opts)
    if result.1 != nil is
        error_response(res, 400, container::op_error_message(result.1))
        return
    end
    let mut body: any = json::object()
    json::set(body, "id", result.0)
    json_response(res, 201, body)
end

fn handle_get_container(req: http::Request, res: http::Response) is
    let id: string = http::path_param(req, "id")
    let row: db::ContainerRow? = container::inspect_container(id)
    if row == nil is
        error_response(res, 404, "No such container: " + id)
        return
    end
    json_response(res, 200, container_to_json(row))
end

fn handle_stop_container(req: http::Request, res: http::Response) is
    let id: string = http::path_param(req, "id")
    let result: container::OpError? = container::stop_container(id, 5000)
    if result != nil is
        error_response(res, 400, container::op_error_message(result))
        return
    end
    http::set_status(res, 204)
end

fn handle_restart_container(req: http::Request, res: http::Response) is
    let id: string = http::path_param(req, "id")
    let result: container::OpError? = container::restart_container(id)
    if result != nil is
        error_response(res, 400, container::op_error_message(result))
        return
    end
    http::set_status(res, 204)
end

fn handle_delete_container(req: http::Request, res: http::Response) is
    let id: string = http::path_param(req, "id")
    let force: bool = http::query_bool(req, "force", false)
    let result: container::OpError? = container::remove_container(id, force)
    if result != nil is
        error_response(res, 400, container::op_error_message(result))
        return
    end
    http::set_status(res, 204)
end

fn handle_container_stats(req: http::Request, res: http::Response) is
    let id: string = http::path_param(req, "id")
    let stats: metrics::ContainerStats? = container::container_stats(id)
    if stats == nil is
        error_response(res, 404, "No such container: " + id)
        return
    end
    let s: metrics::ContainerStats = stats
    let mut body: any = json::object()
    json::set(body, "memory_bytes", metrics::stats_memory_bytes(s))
    json::set(body, "memory_limit", metrics::stats_memory_limit(s))
    json::set(body, "cpu_percent", metrics::stats_cpu_percent(s))
    json::set(body, "pids", metrics::stats_pids(s))
    json::set(body, "net_rx_bytes", metrics::stats_net_rx_bytes(s))
    json::set(body, "net_tx_bytes", metrics::stats_net_tx_bytes(s))
    json_response(res, 200, body)
end

fn handle_container_logs(req: http::Request, res: http::Response) is
    let id: string = http::path_param(req, "id")
    let lines: int = http::query_int(req, "lines", 100)
    let logs: [string]? = container::container_logs(id, lines)
    if logs == nil is
        error_response(res, 404, "No such container: " + id)
        return
    end
    http::set_status(res, 200)
    http::set_header(res, "Content-Type", "text/plain")
    http::write_body(res, str::join(logs, "\n"))
end

fn handle_list_pods(req: http::Request, res: http::Response) is
    let page: int = http::query_int(req, "page", 1)
    let per_page: int = http::query_int(req, "per_page", 50)
    let result: ([db::PodRow], int) = pod::list_pods(page, per_page)
    let mut items: [any] = []
    for p in result.0 is
        items = array_push(items, pod_to_json(p))
    end
    let mut body: any = json::object()
    json::set(body, "items", items)
    json::set(body, "total", result.1)
    json_response(res, 200, body)
end

fn handle_create_pod(req: http::Request, res: http::Response) is
    let parsed: any? = json::parse(http::body_text(req))
    if parsed == nil is
        error_response(res, 400, "Invalid JSON body")
        return
    end
    let b: any = parsed
    let opts: pod::PodCreateOptions = pod::PodCreateOptions {
        name: json::get_string(b, "name", ""),
        shared_network: json::get_bool(b, "shared_network", true),
        shared_pid: json::get_bool(b, "shared_pid", true),
        shared_ipc: json::get_bool(b, "shared_ipc", true),
        cni_network: json::get_string(b, "cni_network", "")
    }
    let result: (string, pod::OpError?) = pod::create_pod(opts)
    if result.1 != nil is
        error_response(res, 400, pod::op_error_message(result.1))
        return
    end
    let mut body: any = json::object()
    json::set(body, "name", result.0)
    json_response(res, 201, body)
end

fn handle_delete_pod(req: http::Request, res: http::Response) is
    let name: string = http::path_param(req, "name")
    let force: bool = http::query_bool(req, "force", false)
    let result: pod::OpError? = pod::remove_pod(name, force)
    if result != nil is
        error_response(res, 400, pod::op_error_message(result))
        return
    end
    http::set_status(res, 204)
end

