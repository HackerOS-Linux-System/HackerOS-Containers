fn handle_healthz(req: http::Request, res: http::Response) is
    http::set_status(res, 200)
    http::write_body(res, "ok")
end

fn handle_metrics(req: http::Request, res: http::Response) is
    let result: ([db::ContainerRow], int) = container::list_containers(1, 10000)
    let mut samples: [(string, string, metrics::ContainerStats)] = []
    for c in result.0 is
        if db::row_status(c) == "Running" is
            samples = array_push(samples, (db::row_id(c), db::row_name(c), metrics::collect_stats(db::row_id(c), db::row_pid(c))))
        end
    end
    http::set_status(res, 200)
    http::set_header(res, "Content-Type", "text/plain; version=0.0.4")
    http::write_body(res, metrics::render_prometheus(samples))
end

;; ── routing / bootstrap ───────────────────────────────────────────────────────

pub fn run_server(bind_addr: string, cert_path: string, key_path: string, socket_activated: bool) is
    let mut router: http::Router = http::new_router()

    http::get(router, "/healthz", handle_healthz)
    http::get(router, "/metrics", handle_metrics)

    http::get(router, "/containers", handle_list_containers)
    http::post(router, "/containers", handle_create_container)
    http::get(router, "/containers/:id", handle_get_container)
    http::post(router, "/containers/:id/stop", handle_stop_container)
    http::post(router, "/containers/:id/restart", handle_restart_container)
    http::delete(router, "/containers/:id", handle_delete_container)
    http::get(router, "/containers/:id/stats", handle_container_stats)
    http::get(router, "/containers/:id/logs", handle_container_logs)

    http::get(router, "/pods", handle_list_pods)
    http::post(router, "/pods", handle_create_pod)
    http::delete(router, "/pods/:name", handle_delete_pod)

    if tls::tls_files_present(cert_path, key_path) is
        let tls_cfg: any? = tls::build_server_config(cert_path, key_path)
        if tls_cfg != nil is
            log::info("hco API listening on https://" + bind_addr)
            http::serve_tls(router, bind_addr, tls_cfg, socket_activated)
            return
        end
        log::warn("TLS requested but cert/key could not be loaded; falling back to HTTP")
    end

    log::info("hco API listening on http://" + bind_addr)
    http::serve(router, bind_addr, socket_activated)
end
