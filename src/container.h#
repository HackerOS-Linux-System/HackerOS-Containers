pub fn run_valued() -> [string] is
    return ["--name", "--hostname", "-h", "-w", "--workdir", "-u", "--user", "--network", "--net", "-m", "--memory", "--cpus", "--pids-limit", "--cpu-shares", "-e", "--env", "-v", "--volume", "-p", "--publish", "--entrypoint", "--cap-add", "--cap-drop", "-l", "--label", "--restart", "--pod", "--preset", "--seccomp", "--health-cmd", "--health-interval", "--env-file", "--rootfs"]
end

;; Validates every flag of `run` / `create`; returns "" or the first problem.
fn check_flags(p: args::Parsed) -> string is
    let nm: string = args::get(p, ["--name"])
    if nm != "" is
        let bad: string = validation::name(nm)
        if bad != "" is return "--name: " + bad end
    end
    let net: string = utils::or_default(args::get(p, ["--network", "--net"]), "bridge")
    let nbad: string = validation::network_mode(net)
    if nbad != "" is return "--network: " + nbad end
    let mem: string = args::get(p, ["-m", "--memory"])
    if mem != "" is
        let b: string = validation::memory(mem)
        if b != "" is return "--memory: " + b end
    end
    let cpus: string = args::get(p, ["--cpus"])
    if cpus != "" is
        let b2: string = validation::cpus(cpus)
        if b2 != "" is return "--cpus: " + b2 end
    end
    let ports: [string] = args::all(p, ["-p", "--publish"])
    let mut i: int = 0
    while i < array_len(ports) is
        let b3: string = validation::publish(ports[i])
        if b3 != "" is return "--publish: " + b3 end
        i += 1
    end
    let vols: [string] = args::all(p, ["-v", "--volume"])
    let mut j: int = 0
    while j < array_len(vols) is
        let b4: string = validation::volume(vols[j])
        if b4 != "" is return "--volume: " + b4 end
        j += 1
    end
    let envs: [string] = args::all(p, ["-e", "--env"])
    let mut k: int = 0
    while k < array_len(envs) is
        let b5: string = validation::env_pair(envs[k])
        if b5 != "" is return "--env: " + b5 end
        k += 1
    end
    let pol: string = args::get(p, ["--restart"])
    if pol != "" is
        let b6: string = validation::restart_policy(pol)
        if b6 != "" is return b6 end
    end
    let pre: string = args::get(p, ["--preset"])
    if pre != "" && !sandbox::known(pre) is return "unknown preset '" + pre + "' (see: hco preset ls)" end
    return ""
end

;; Creates a container from parsed `run` flags: positional 0 is the image,
;; the rest the command. Returns the container id, or "" after printing why.
pub fn create_from(s: ctr::store::Store, p: args::Parsed, quiet_out: bool) -> string is
    let image: string = args::pos_at(p, 0)
    let ibad: string = validation::image_ref(image)
    if ibad != "" is
        ui::error(ibad)
        ui::hint("usage: hco run [options] IMAGE [COMMAND...]")
        return ""
    end
    let fbad: string = check_flags(p)
    if fbad != "" is
        ui::error(fbad)
        return ""
    end
    let pod: string = args::get(p, ["--pod"])
    if pod != "" && !db::pod_exists(s, pod) is
        ui::error("no such pod: " + pod)
        ui::hint("create it first: hco pod create " + pod)
        return ""
    end
    if !ctr::image_exists(s, image) is
        if !quiet_out is ui::step(1, 2, "image " + colors::bold(image) + " not present, pulling") end
        if ctr::image_pull(s, image) == "" is
            ui::error("cannot pull " + image)
            return ""
        end
    end

    let mut o = ctr::container_options(image)
    ;; pod defaults first, so explicit flags below win
    if pod != "" is
        let keys: [string] = ["network", "memory", "cpus"]
        let mut ki: int = 0
        while ki < array_len(keys) is
            let v: string = db::pod_get(s, pod, keys[ki])
            if v != "" is o = ctr::set_option(o, keys[ki], v) end
            ki += 1
        end
    end
    let mut pre: string = args::get(p, ["--preset"])
    if pre == "" && args::flag(p, ["--hardened"]) is pre = "hardened" end
    if pre == "" && pod != "" is pre = db::pod_get(s, pod, "preset") end
    if pre != "" is
        let items: [string] = sandbox::preset(pre)
        let mut pi: int = 0
        while pi < array_len(items) is
            let it: string = items[pi]
            if string_starts_with(it, "+") is
                o = ctr::add_option(o, utils::head_before(string_slice(it, 1, string_len(it)), "="), utils::tail_after(it, "="))
            else is
                o = ctr::set_option(o, utils::head_before(it, "="), utils::tail_after(it, "="))
            end
            pi += 1
        end
    end

    let singles: [string] = ["--name|name", "--hostname|hostname", "-h|hostname", "-w|workdir", "--workdir|workdir", "-u|user", "--user|user", "--network|network", "--net|network", "-m|memory", "--memory|memory", "--cpus|cpus", "--pids-limit|pids", "--cpu-shares|shares", "--rootfs|rootfs_dir"]
    let mut si: int = 0
    while si < array_len(singles) is
        let flag_name: string = utils::head_before(singles[si], "|")
        let key: string = utils::tail_after(singles[si], "|")
        let v2: string = args::get(p, [flag_name])
        if v2 != "" is o = ctr::set_option(o, key, v2) end
        si += 1
    end
    if args::flag(p, ["--read-only"]) is o = ctr::set_option(o, "readonly", "true") end
    if args::flag(p, ["--privileged"]) is o = ctr::set_option(o, "privileged", "true") end
    if args::flag(p, ["--rm"]) is o = ctr::set_option(o, "rm", "true") end
    if args::flag(p, ["-d", "--detach"]) is o = ctr::set_option(o, "detach", "true") end

    let repeat: [string] = ["-e|env", "--env|env", "-v|volume", "--volume|volume", "-p|publish", "--publish|publish", "--entrypoint|entrypoint", "--cap-add|cap_add", "--cap-drop|cap_drop", "-l|label", "--label|label"]
    let mut ri: int = 0
    while ri < array_len(repeat) is
        let rf: string = utils::head_before(repeat[ri], "|")
        let rk: string = utils::tail_after(repeat[ri], "|")
        let vals: [string] = args::all(p, [rf])
        let mut vi: int = 0
        while vi < array_len(vals) is
            o = ctr::add_option(o, rk, vals[vi])
            vi += 1
        end
        ri += 1
    end
    let envf: string = args::get(p, ["--env-file"])
    if envf != "" is
        if !file_exists(envf) is
            ui::error("env file not found: " + envf)
            return ""
        end
        let el: [string] = utils::lines(utils::read(envf))
        let mut ei: int = 0
        while ei < array_len(el) is
            if !string_starts_with(el[ei], "#") && string_find(el[ei], "=") > 0 is o = ctr::add_option(o, "env", el[ei]) end
            ei += 1
        end
    end
    o = ctr::set_command(o, args::rest_from(p, 1))

    let id: string = ctr::container_create(s, o)
    if id == "" is
        ui::error("the library could not create the container")
        ui::hint("check the host with: hco doctor")
        return ""
    end
    let mut policy: string = args::get(p, ["--restart"])
    if policy == "" && pod != "" is policy = db::pod_get(s, pod, "restart") end
    db::meta_set(s, id, "policy", utils::or_default(policy, "no"))
    db::meta_set(s, id, "image", image)
    db::meta_set(s, id, "created", to_string(utils::now_unix()))
    if pod != "" is db::meta_set(s, id, "pod", pod) end
    if pre != "" is db::meta_set(s, id, "preset", pre) end
    let sec: string = args::get(p, ["--seccomp"])
    if sec != "" is db::meta_set(s, id, "seccomp", sec) end
    let hc: string = args::get(p, ["--health-cmd"])
    if hc != "" is
        db::meta_set(s, id, "health_cmd", hc)
        db::meta_set(s, id, "health_interval", utils::or_default(args::get(p, ["--health-interval"]), "30"))
    end
    db::event(s, "container", utils::short_id(id), "create " + image)
    return id
end

;; hco run [options] IMAGE [COMMAND...]
pub fn cmd_run(s: ctr::store::Store, argv: [string]) -> int is
    let p = args::parse(argv, run_valued(), true)
    let detach: bool = args::flag(p, ["-d", "--detach"])
    let id: string = create_from(s, p, detach)
    if id == "" is return 1 end
    db::event(s, "container", utils::short_id(id), "start")
    if detach is
        let rc: int = ctr::container_start(s, id, false)
        if rc != 0 is return ui::fail("container " + utils::short_id(id) + " did not start (see: hco logs " + utils::short_id(id) + ")") end
        write(utils::short_id(id))
        return 0
    end
    let code: int = ctr::container_start(s, id, true)
    db::event(s, "container", utils::short_id(id), "exit " + to_string(code))
    return code
end

;; hco create [options] IMAGE [COMMAND...]
pub fn cmd_create(s: ctr::store::Store, argv: [string]) -> int is
    let p = args::parse(argv, run_valued(), true)
    let id: string = create_from(s, p, false)
    if id == "" is return 1 end
    write(utils::short_id(id))
    return 0
end

;; Runs `act` over every named container. act: start|stop|restart|kill|rm
fn each(s: ctr::store::Store, names: [string], act: string, timeout: int, sig: string, force: bool) -> int is
    if array_len(names) == 0 is return ui::fail("usage: hco " + act + " CONTAINER...") end
    let mut failed: int = 0
    let mut i: int = 0
    while i < array_len(names) is
        let id: string = backend::resolve(s, names[i])
        if id == "" is
            failed += 1
        else is
            let label: string = utils::short_id(id)
            let mut good: bool = false
            if act == "start" is
                good = ctr::container_start(s, id, false) == 0
            else if act == "stop" is
                good = ctr::container_stop(s, id, timeout)
            else if act == "restart" is
                ctr::container_stop(s, id, timeout)
                good = ctr::container_start(s, id, false) == 0
            else if act == "kill" is
                good = ctr::container_kill(s, id, sig)
            else is
                good = ctr::container_remove(s, id, force)
                if good is db::meta_drop(s, id) end
            end
            if good && (act == "stop" || act == "kill") is db::meta_set(s, id, "user_stopped", "1") end
            if good && (act == "start" || act == "restart") is db::meta_set(s, id, "user_stopped", "0") end
            if good is
                ui::success(act + " " + colors::bold(utils::or_default(names[i], label)) + " " + colors::theme::muted(label))
                db::event(s, "container", label, act)
            else is
                ui::error("cannot " + act + " " + names[i])
                failed += 1
            end
        end
        i += 1
    end
    if failed > 0 is return 1 end
    return 0
end

pub fn cmd_start(s: ctr::store::Store, argv: [string]) -> int is
    return each(s, argv, "start", 10, "TERM", false)
end

pub fn cmd_stop(s: ctr::store::Store, argv: [string]) -> int is
    let p = args::parse(argv, ["-t", "--time"], false)
    return each(s, args::pos(p), "stop", utils::atoi(utils::or_default(args::get(p, ["-t", "--time"]), "10")), "TERM", false)
end

pub fn cmd_restart(s: ctr::store::Store, argv: [string]) -> int is
    let p = args::parse(argv, ["-t", "--time"], false)
    return each(s, args::pos(p), "restart", utils::atoi(utils::or_default(args::get(p, ["-t", "--time"]), "10")), "TERM", false)
end

pub fn cmd_kill(s: ctr::store::Store, argv: [string]) -> int is
    let p = args::parse(argv, ["-s", "--signal"], false)
    let sig: string = utils::or_default(args::get(p, ["-s", "--signal"]), "KILL")
    let bad: string = validation::signal(sig)
    if bad != "" is return ui::fail(bad) end
    return each(s, args::pos(p), "kill", 0, sig, false)
end

pub fn cmd_rm(s: ctr::store::Store, argv: [string]) -> int is
    let p = args::parse(argv, [], false)
    return each(s, args::pos(p), "rm", 0, "", args::flag(p, ["-f", "--force"]))
end

;; ── ps ───────────────────────────────────────────────────────────────────────

fn cmd_cell(c: string) -> string is
    let t: string = if string_len(c) > 28 then string_slice(c, 0, 27) + "…" else c end
    return colors::theme::muted(t)
end

;; hco ps [-a] [-q] [--pod NAME]
pub fn cmd_ps(s: ctr::store::Store, argv: [string]) -> int is
    let p = args::parse(argv, ["--pod", "--status"], false)
    let all: bool = args::flag(p, ["-a", "--all"])
    let pod: string = args::get(p, ["--pod"])
    let want: string = args::get(p, ["--status"])
    let list: [ctr::runtime::ContainerInfo] = ctr::container_list(s)
    let mut t = ui::table(["ID", "NAME", "IMAGE", "STATUS", "POD", "IP", "COMMAND"])
    let mut shown: int = 0
    let mut i: int = 0
    while i < array_len(list) is
        let c: ctr::runtime::ContainerInfo = list[i]
        let keep_state: bool = all || c.ci_status == "running"
        let keep_pod: bool = pod == "" || db::meta_get(s, c.ci_id, "pod") == pod
        let keep_status: bool = want == "" || c.ci_status == want
        if keep_state && keep_pod && keep_status is
            if args::flag(p, ["-q", "--quiet"]) is
                write(utils::short_id(c.ci_id))
            else is
                let mut st: string = ui::status_badge(c.ci_status)
                if c.ci_status == "exited" is st = st + colors::theme::muted(" (" + to_string(c.ci_exit) + ")") end
                let podn: string = db::meta_get(s, c.ci_id, "pod")
                t = ui::add_row(t, [colors::theme::code(utils::short_id(c.ci_id)), colors::bold(c.ci_name), c.ci_image, st, if podn == "" then ui::muted("—") else colors::fg::mediumpurple(podn) end, utils::or_default(c.ci_ip, "—"), cmd_cell(c.ci_command)])
            end
            shown += 1
        end
        i += 1
    end
    if args::flag(p, ["-q", "--quiet"]) is return 0 end
    if shown == 0 is
        ui::info(if all then "no containers" else "no running containers" end)
        if !all is ui::hint("show stopped ones too: hco ps -a") end
        return 0
    end
    ui::print_table(t)
    return 0
end

;; ── logs / exec / wait / inspect ─────────────────────────────────────────────

;; hco logs [-f] [--tail N] CONTAINER
pub fn cmd_logs(s: ctr::store::Store, argv: [string]) -> int is
    let p = args::parse(argv, ["--tail", "-n"], false)
    let id: string = backend::resolve(s, args::pos_at(p, 0))
    if id == "" is return 1 end
    let tail: int = utils::atoi(utils::or_default(args::get(p, ["--tail", "-n"]), "0"))
    if args::flag(p, ["-f", "--follow"]) is
        let n: int = if tail > 0 then tail else 50 end
        return utils::run("tail -n " + to_string(n) + " -f " + utils::sq(s.st_root + "/containers/" + id + "/console.log"))
    end
    if tail > 0 is
        write(ctr::container_logs_tail(s, id, tail))
    else is
        write(ctr::container_logs(s, id))
    end
    return 0
end

;; hco exec [-e K=V] [-u USER] [-w DIR] CONTAINER COMMAND...
pub fn cmd_exec(s: ctr::store::Store, argv: [string]) -> int is
    let p = args::parse(argv, ["-e", "--env", "-u", "--user", "-w", "--workdir"], true)
    let id: string = backend::resolve(s, args::pos_at(p, 0))
    if id == "" is return 1 end
    let cmd: [string] = args::rest_from(p, 1)
    if array_len(cmd) == 0 is return ui::fail("usage: hco exec [options] CONTAINER COMMAND...") end
    if !backend::is_running(s, id) is return ui::fail("container " + utils::short_id(id) + " is not running") end
    return ctr::container_exec(s, id, cmd, args::all(p, ["-e", "--env"]), args::get(p, ["-u", "--user"]), args::get(p, ["-w", "--workdir"]))
end

pub fn cmd_wait(s: ctr::store::Store, argv: [string]) -> int is
    let p = args::parse(argv, ["--timeout"], false)
    let id: string = backend::resolve(s, args::pos_at(p, 0))
    if id == "" is return 1 end
    let code: int = ctr::container_wait(s, id, utils::atoi(utils::or_default(args::get(p, ["--timeout"]), "0")) * 1000)
    write(to_string(code))
    return 0
end

;; hco rename OLD NEW
pub fn cmd_rename(s: ctr::store::Store, argv: [string]) -> int is
    if array_len(argv) != 2 is return ui::fail("usage: hco rename CONTAINER NEW_NAME") end
    let bad: string = validation::name(argv[1])
    if bad != "" is return ui::fail(bad) end
    let id: string = backend::resolve(s, argv[0])
    if id == "" is return 1 end
    if ctr::container_find(s, argv[1]) != "" is return ui::fail("the name " + argv[1] + " is already in use") end
    utils::kv_set(s.st_root + "/containers/" + id + "/state", "name", argv[1])
    ui::success(argv[0] + " " + colors::theme::muted("→") + " " + colors::bold(argv[1]))
    return 0
end

;; hco inspect CONTAINER [--raw]
pub fn cmd_inspect(s: ctr::store::Store, argv: [string]) -> int is
    let p = args::parse(argv, [], false)
    let id: string = backend::resolve(s, args::pos_at(p, 0))
    if id == "" is return 1 end
    if args::flag(p, ["--raw"]) is
        let raw: string = ctr::container_inspect(s, id)
        if utils::tool_exists("jq") is
            write(utils::capture("printf '%s' " + utils::sq(raw) + " | jq ."))
        else is
            write(raw)
        end
        return 0
    end
    let st: string = ctr::container_status(s, id)
    ui::title("container " + backend::name_of(s, id))
    ui::kv("Id", colors::theme::code(id))
    ui::kv("Status", ui::status_badge(st))
    ui::kv("Image", db::meta_get(s, id, "image"))
    ui::kv("Pid", if ctr::container_pid(s, id) > 0 then to_string(ctr::container_pid(s, id)) else "—" end)
    ui::kv("Exit code", if st == "running" then "—" else to_string(ctr::container_exit_code(s, id)) end)
    ui::kv("Restart", utils::or_default(db::meta_get(s, id, "policy"), "no"))
    ui::kv("Pod", utils::or_default(db::meta_get(s, id, "pod"), "—"))
    ui::kv("Preset", utils::or_default(db::meta_get(s, id, "preset"), "—"))
    ui::kv("Seccomp", utils::or_default(db::meta_get(s, id, "seccomp"), "—"))
    ui::kv("Health", utils::or_default(db::meta_get(s, id, "health_cmd"), "—"))
    ui::kv("Network", utils::or_default(utils::kv_get(s.st_root + "/containers/" + id + "/state", "network"), "—"))
    ui::kv("IP", utils::or_default(utils::kv_get(s.st_root + "/containers/" + id + "/state", "ip"), "—"))
    ui::kv("Ports", utils::or_default(utils::kv_get(s.st_root + "/containers/" + id + "/state", "publish"), "—"))
    ui::kv("Command", utils::or_default(utils::kv_get(s.st_root + "/containers/" + id + "/state", "command"), "—"))
    ui::kv("Bundle", ctr::container_bundle(s, id))
    ui::blank()
    ui::hint("full JSON: hco inspect " + utils::short_id(id) + " --raw")
    return 0
end

;; hco prune — removes every stopped container.
pub fn cmd_prune(s: ctr::store::Store, argv: [string]) -> int is
    let p = args::parse(argv, [], false)
    let list: [ctr::runtime::ContainerInfo] = ctr::container_list(s)
    let mut victims: [string] = []
    let mut i: int = 0
    while i < array_len(list) is
        if list[i].ci_status != "running" && list[i].ci_status != "created" is victims = array_push(victims, list[i].ci_id) end
        i += 1
    end
    if array_len(victims) == 0 is
        ui::info("nothing to prune")
        return 0
    end
    if !args::flag(p, ["-f", "--force"]) && !ui::confirm("remove " + to_string(array_len(victims)) + " stopped container(s)?") is
        ui::info("cancelled")
        return 0
    end
    let mut n: int = 0
    let mut k: int = 0
    while k < array_len(victims) is
        if ctr::container_remove(s, victims[k], true) is
            db::meta_drop(s, victims[k])
            n += 1
        end
        k += 1
    end
    ui::success("removed " + to_string(n) + " container(s)")
    return 0
end

;; ── health + supervision ─────────────────────────────────────────────────────

;; Runs the container's health command. Returns "healthy", "unhealthy" or "none".
pub fn health_of(s: ctr::store::Store, id: string) -> string is
    let hc: string = db::meta_get(s, id, "health_cmd")
    if hc == "" is return "none" end
    if !backend::is_running(s, id) is return "unhealthy" end
    let rc: int = ctr::container_exec(s, id, ["sh", "-c", hc], [], "", "")
    if rc == 0 is return "healthy" end
    return "unhealthy"
end

;; hco health CONTAINER
pub fn cmd_health(s: ctr::store::Store, argv: [string]) -> int is
    if array_len(argv) != 1 is return ui::fail("usage: hco health CONTAINER") end
    let id: string = backend::resolve(s, argv[0])
    if id == "" is return 1 end
    let h: string = health_of(s, id)
    if h == "none" is
        ui::info("no health check configured")
        ui::hint("set one with: hco run --health-cmd 'curl -f localhost' ...")
        return 0
    end
    write(ui::status_badge(h))
    if h == "healthy" is return 0 end
    return 1
end

;; One supervision pass: restart containers whose policy says so.
;; Returns the number of restarts performed.
pub fn supervise_once(s: ctr::store::Store) -> int is
    let list: [ctr::runtime::ContainerInfo] = ctr::container_list(s)
    let mut n: int = 0
    let mut i: int = 0
    while i < array_len(list) is
        let c: ctr::runtime::ContainerInfo = list[i]
        let pol: string = db::meta_get(s, c.ci_id, "policy")
        let stopped_by_user: bool = db::meta_get(s, c.ci_id, "user_stopped") == "1"
        if c.ci_status == "exited" && !stopped_by_user is
            let restart: bool = pol == "always" || pol == "unless-stopped" || (pol == "on-failure" && c.ci_exit != 0)
            if restart is
                let count: int = utils::atoi(db::meta_get(s, c.ci_id, "restarts")) + 1
                db::meta_set(s, c.ci_id, "restarts", to_string(count))
                if ctr::container_start(s, c.ci_id, false) == 0 is
                    db::event(s, "container", utils::short_id(c.ci_id), "auto-restart #" + to_string(count) + " (policy " + pol + ")")
                    ui::info("restarted " + colors::bold(c.ci_name) + " " + colors::theme::muted("(policy " + pol + ", #" + to_string(count) + ")"))
                    n += 1
                end
            end
        end
        i += 1
    end
    return n
end

;; hco supervise [--interval SECONDS] [--once]
pub fn cmd_supervise(s: ctr::store::Store, argv: [string]) -> int is
    let p = args::parse(argv, ["--interval"], false)
    let every: int = utils::atoi(utils::or_default(args::get(p, ["--interval"]), "5"))
    if args::flag(p, ["--once"]) is
        write(to_string(supervise_once(s)))
        return 0
    end
    ui::info("supervising restart policies every " + to_string(every) + "s — Ctrl-C to stop")
    while true is
        supervise_once(s)
        sleep_ms(every * 1000)
    end
    return 0
end
