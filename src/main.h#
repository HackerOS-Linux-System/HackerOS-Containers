fn cmd_preset(argv: [string]) -> int is
    if array_len(argv) == 0 || argv[0] == "ls" is
        let mut t = ui::table(["PRESET", "OPTIONS", "DESCRIPTION"])
        let names: [string] = sandbox::presets()
        let mut i: int = 0
        while i < array_len(names) is
            t = ui::add_row(t, [colors::bold(names[i]), to_string(array_len(sandbox::preset(names[i]))), sandbox::describe(names[i])])
            i += 1
        end
        ui::print_table(t)
        return 0
    end
    if argv[0] == "show" is
        if array_len(argv) != 2 || !sandbox::known(argv[1]) is return ui::fail("usage: hco preset show NAME (see: hco preset ls)") end
        ui::title("preset " + argv[1])
        ui::out("  " + ui::muted(sandbox::describe(argv[1])))
        let items: [string] = sandbox::preset(argv[1])
        let mut k: int = 0
        while k < array_len(items) is
            ui::out("  " + colors::theme::code(items[k]))
            k += 1
        end
        return 0
    end
    return ui::fail("unknown preset command: " + argv[0])
end

fn cmd_image(s: ctr::store::Store, argv: [string]) -> int is
    if array_len(argv) == 0 is return ui::fail_hint("usage: hco image SUBCOMMAND", "ls pull rm inspect history prune tag build save load import push") end
    let sub: string = argv[0]
    let rest: [string] = args::argv_tail(argv, 1)
    if sub == "ls" || sub == "list" is return image::cmd_images(s, rest) end
    if sub == "pull" is return image::cmd_pull(s, rest) end
    if sub == "rm" || sub == "remove" is return image::cmd_rmi(s, rest) end
    if sub == "inspect" is return image::cmd_inspect(s, rest) end
    if sub == "history" is return image::cmd_history(s, rest) end
    if sub == "prune" is return image::cmd_prune(s) end
    if sub == "tag" is return image::cmd_tag(s, rest) end
    if sub == "build" is return image::cmd_build(s, rest) end
    if sub == "save" is return image::cmd_save(s, rest) end
    if sub == "load" is return image::cmd_load(s, rest) end
    if sub == "import" is return image::cmd_import(s, rest) end
    if sub == "push" is return image::cmd_push(s, rest) end
    return ui::fail("unknown image command: " + sub)
end

fn dispatch(s: ctr::store::Store, cmd: string, rest: [string]) -> int is
    if cmd == "run" is return container::cmd_run(s, rest) end
    if cmd == "create" is return container::cmd_create(s, rest) end
    if cmd == "start" is return container::cmd_start(s, rest) end
    if cmd == "stop" is return container::cmd_stop(s, rest) end
    if cmd == "restart" is return container::cmd_restart(s, rest) end
    if cmd == "kill" is return container::cmd_kill(s, rest) end
    if cmd == "rm" is return container::cmd_rm(s, rest) end
    if cmd == "ps" || cmd == "ls" is return container::cmd_ps(s, rest) end
    if cmd == "logs" is return container::cmd_logs(s, rest) end
    if cmd == "exec" is return container::cmd_exec(s, rest) end
    if cmd == "inspect" is return container::cmd_inspect(s, rest) end
    if cmd == "wait" is return container::cmd_wait(s, rest) end
    if cmd == "rename" is return container::cmd_rename(s, rest) end
    if cmd == "prune" is return container::cmd_prune(s, rest) end
    if cmd == "health" is return container::cmd_health(s, rest) end
    if cmd == "supervise" is return container::cmd_supervise(s, rest) end
    if cmd == "top" is return metrics::cmd_top(s, rest) end
    if cmd == "stats" is return metrics::cmd_stats(s, rest) end
    if cmd == "metrics" is return metrics::cmd_metrics(s) end
    if cmd == "port" is return network::cmd_port(s, rest) end
    if cmd == "images" is return image::cmd_images(s, rest) end
    if cmd == "pull" is return image::cmd_pull(s, rest) end
    if cmd == "rmi" is return image::cmd_rmi(s, rest) end
    if cmd == "tag" is return image::cmd_tag(s, rest) end
    if cmd == "history" is return image::cmd_history(s, rest) end
    if cmd == "build" is return image::cmd_build(s, rest) end
    if cmd == "save" is return image::cmd_save(s, rest) end
    if cmd == "load" is return image::cmd_load(s, rest) end
    if cmd == "import" is return image::cmd_import(s, rest) end
    if cmd == "push" is return image::cmd_push(s, rest) end
    if cmd == "login" is return image::cmd_login(s, rest) end
    if cmd == "logout" is return image::cmd_logout(s, rest) end
    if cmd == "image" is return cmd_image(s, rest) end
    if cmd == "pod" is return pod::cmd_pod(s, rest) end
    if cmd == "volume" is return volume::cmd_volume(s, rest) end
    if cmd == "network" is return network::cmd_network(s, rest) end
    if cmd == "seccomp" is return seccomp::cmd_seccomp(s, rest) end
    if cmd == "preset" is return cmd_preset(rest) end
    if cmd == "up" is return stack::cmd_up(s, rest) end
    if cmd == "down" is return stack::cmd_down(s, rest) end
    if cmd == "serve" is return api::cmd_serve(s, rest) end
    if cmd == "api" is return api::cmd_api(s, rest) end
    if cmd == "api-conn" is return api::serve_conn(s) end
    if cmd == "tls" is return tls::cmd_tls(s, rest) end
    if cmd == "doctor" is return system::cmd_doctor(s) end
    if cmd == "info" is return system::cmd_info(s) end
    if cmd == "df" is return system::cmd_df(s) end
    if cmd == "events" is return system::cmd_events(s, rest) end
    if cmd == "config" is return system::cmd_config() end
    if cmd == "system" is
        if array_len(rest) > 0 && rest[0] == "prune" is return system::cmd_system_prune(s, args::argv_tail(rest, 1)) end
        return ui::fail("usage: hco system prune [-f]")
    end
    ui::error("unknown command: " + cmd)
    ui::hint("see all commands with: hco help")
    return 127
end

fn main() is
    let raw: [string] = env_args()
    let mut argv: [string] = args::argv_tail(raw, 1)
    let mut root: string = ""
    let mut driver: string = ""
    let mut kept: [string] = []
    let mut i: int = 0
    while i < array_len(argv) is
        let a: string = argv[i]
        if a == "--no-color" is
            ui::disable_color()
        else if a == "--root" && i + 1 < array_len(argv) is
            root = argv[i + 1]
            i += 1
        else if a == "--driver" && i + 1 < array_len(argv) is
            driver = argv[i + 1]
            i += 1
        else is
            kept = array_push(kept, a)
        end
        i += 1
    end
    argv = kept
    if array_len(argv) == 0 || argv[0] == "help" || argv[0] == "--help" || argv[0] == "-h" is
        help_all()
        exit(0)
    end
    let cmd: string = argv[0]
    let rest: [string] = args::argv_tail(argv, 1)
    if cmd == "version" || cmd == "--version" || cmd == "-V" is
        exit(system::cmd_version(rest))
    end
    if cmd == "completion" is exit(system::cmd_completion(rest)) end
    backend::configure(root, driver)
    let s = ctr::open_default_store()
    exit(dispatch(s, cmd, rest))
end
