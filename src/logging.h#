use "bit -> colors"

mod utils

fn log_path() -> string is
    let p: string = env_get("HCO_LOG")
    if p != "" is return p end
    return "/tmp/hco.log"
end

fn level_rank(l: string) -> int is
    if l == "debug" is return 0 end
    if l == "info" is return 1 end
    if l == "warn" is return 2 end
    return 3
end

fn min_rank() -> int is
    let l: string = env_get("HCO_LOG_LEVEL")
    if l == "" is return 1 end
    return level_rank(string_lower(l))
end

fn emit(level: string, msg: string, to_term: bool) is
    if level_rank(level) < min_rank() is return end
    utils::append_line(log_path(), utils::now_iso() + " [" + string_upper(level) + "] " + colors::strip(msg))
    if !to_term is return end
    if level == "debug" is
        write(colors::theme::debug(msg))
    else if level == "info" is
        write(colors::theme::info(msg))
    else if level == "warn" is
        write(colors::theme::warning(msg))
    else is
        write(colors::theme::error(msg))
    end
end

pub fn debug(msg: string) is emit("debug", msg, env_get("HCO_DEBUG") != "") end
pub fn info(msg: string) is emit("info", msg, true) end
pub fn warn(msg: string) is emit("warn", msg, true) end
pub fn error(msg: string) is emit("error", msg, true) end

;; Records an event without printing it.
pub fn quiet(level: string, msg: string) is emit(level, msg, false) end
