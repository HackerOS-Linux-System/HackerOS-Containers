mod utils

fn all_in(s: string, allowed: string) -> bool is
    let mut i: int = 0
    while i < string_len(s) is
        if !string_contains(allowed, string_at(s, i)) is return false end
        i += 1
    end
    return true
end

const NAME_CHARS: string = "abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789_.-"
const ALNUM: string = "abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789"

;; Container / pod / volume names: [a-zA-Z0-9][a-zA-Z0-9_.-]{0,62}
pub fn name(n: string) -> string is
    if n == "" is return "name must not be empty" end
    if string_len(n) > 63 is return "name is longer than 63 characters" end
    if !string_contains(ALNUM, string_at(n, 0)) is return "name must start with a letter or digit" end
    if !all_in(n, NAME_CHARS) is return "name may only contain letters, digits, '_', '.' and '-'" end
    return ""
end

;; "80", "8080:80", "127.0.0.1:8080:80", with optional "/tcp" or "/udp".
pub fn publish(spec: string) -> string is
    let mut body: string = spec
    let slash: int = string_rfind(spec, "/")
    if slash >= 0 is
        let proto: string = string_slice(spec, slash + 1, string_len(spec))
        if proto != "tcp" && proto != "udp" is return "protocol must be tcp or udp in '" + spec + "'" end
        body = string_slice(spec, 0, slash)
    end
    let parts: [string] = string_split(body, ":")
    let n: int = array_len(parts)
    if n < 1 || n > 3 is return "'" + spec + "' is not [ip:]host:container" end
    let mut i: int = 0
    while i < n is
        let p: string = parts[i]
        if n == 3 && i == 0 is
            if !all_in(p, "0123456789.") || p == "" is return "'" + p + "' is not an IPv4 address" end
        else is
            if !utils::is_number(p) is return "'" + p + "' is not a port number" end
            let v: int = utils::atoi(p)
            if v < 1 || v > 65535 is return "port " + p + " is out of range 1-65535" end
        end
        i += 1
    end
    return ""
end

;; Memory limit such as 256m, 2g.
pub fn memory(v: string) -> string is
    let b: int = utils::parse_size(v)
    if b < 0 is return "'" + v + "' is not a size (try 256m or 2g)" end
    if b < 4194304 is return "memory limit must be at least 4m" end
    return ""
end

;; CPU limit such as 0.5, 2.
pub fn cpus(v: string) -> string is
    if v == "" is return "cpus must not be empty" end
    if !all_in(v, "0123456789.") is return "'" + v + "' is not a number of CPUs" end
    if string_len(v) == 1 && v == "0" is return "cpus must be greater than 0" end
    return ""
end

;; "host-path:/in/container[:ro]" or "name:/in/container".
pub fn volume(spec: string) -> string is
    let parts: [string] = string_split(spec, ":")
    if array_len(parts) < 2 || array_len(parts) > 3 is return "'" + spec + "' is not source:target[:ro]" end
    if parts[0] == "" is return "volume source must not be empty" end
    if !string_starts_with(parts[1], "/") is return "volume target '" + parts[1] + "' must be an absolute path" end
    if array_len(parts) == 3 && parts[2] != "ro" && parts[2] != "rw" is return "volume mode must be ro or rw" end
    return ""
end

pub fn env_pair(spec: string) -> string is
    if string_find(spec, "=") < 1 is return "'" + spec + "' is not NAME=value" end
    let key: string = utils::head_before(spec, "=")
    if string_contains("0123456789", string_at(key, 0)) is return "environment name '" + key + "' must not start with a digit" end
    if !all_in(key, NAME_CHARS) is return "environment name '" + key + "' has invalid characters" end
    return ""
end

pub fn restart_policy(p: string) -> string is
    if p == "no" || p == "always" || p == "on-failure" || p == "unless-stopped" is return "" end
    return "restart policy must be no, on-failure, always or unless-stopped"
end

pub fn network_mode(m: string) -> string is
    if m == "bridge" || m == "host" || m == "none" is return "" end
    return "network must be bridge, host or none"
end

;; Image references: no whitespace, not empty.
pub fn image_ref(r: string) -> string is
    if r == "" is return "image reference must not be empty" end
    if string_contains(r, " ") is return "image reference must not contain spaces" end
    return ""
end

pub fn signal(sig: string) -> string is
    let known: [string] = ["HUP", "INT", "QUIT", "KILL", "TERM", "USR1", "USR2", "STOP", "CONT"]
    let s: string = string_upper(sig)
    let bare: string = if string_starts_with(s, "SIG") then string_slice(s, 3, string_len(s)) else s end
    if utils::has(known, bare) || utils::is_number(bare) is return "" end
    return "unknown signal '" + sig + "'"
end
