mod utils

pub fn presets() -> [string] is
    return ["default", "hardened", "strict", "web", "batch"]
end

pub fn describe(name: string) -> string is
    if name == "default" is return "library defaults, no extra restrictions" end
    if name == "hardened" is return "read-only rootfs, all capabilities dropped, 512 pids" end
    if name == "strict" is return "hardened + no network, 256m memory, 0.5 cpu" end
    if name == "web" is return "hardened + NET_BIND_SERVICE, bridge network" end
    if name == "batch" is return "128 pids, 1g memory, no network" end
    return "unknown preset"
end

pub fn known(name: string) -> bool is
    return utils::has(presets(), name)
end

pub fn preset(name: string) -> [string] is
    if name == "hardened" is
        return ["readonly=true", "pids=512", "+cap_drop=ALL"]
    end
    if name == "strict" is
        return ["readonly=true", "pids=256", "network=none", "memory=256m", "cpus=0.5", "+cap_drop=ALL"]
    end
    if name == "web" is
        return ["readonly=true", "pids=512", "network=bridge", "+cap_drop=ALL", "+cap_add=NET_BIND_SERVICE"]
    end
    if name == "batch" is
        return ["pids=128", "memory=1g", "network=none"]
    end
    return []
end
