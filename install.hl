// curl
// systemd

^> curl -L "https://github.com/HackerOS-Linux-System/HackerOS-Containers/releases/latest/download/hco" -o /usr/bin/hco
^> chmod a+x /usr/bin/hco
^> /usr/bin/hco completion bash > /etc/bash_completion.d/hco
^> mkdir -p /etc/cni/net.d
^> mkdir -p /etc/hco
^> mkdir -p /var/lib/container
^> mkdir -p /var/log/hco
^> curl -sSL https://raw.githubusercontent.com/HackerOS-Linux-System/HackerOS-Containers/main/services/hco-api@.service -o /etc/systemd/system/hco-api@.service
^> curl -sSL https://raw.githubusercontent.com/HackerOS-Linux-System/HackerOS-Containers/main/services/hco-api.socket -o /etc/systemd/system/hco-api.socket
^> curl -sSL https://raw.githubusercontent.com/HackerOS-Linux-System/HackerOS-Containers/main/services/hco-supervisor.service -o /etc/systemd/system/hco-supervisor.service
^> systemctl daemon-reload
