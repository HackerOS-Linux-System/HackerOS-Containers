[Unit]
Description=HackerOS Containers REST API connection handler
Documentation=https://github.com/HackerOS-Linux-System/HackerOS-Containers
# Started by hco-api.socket (Accept=yes), so this unit is instantiated per connection:
# install it as hco-api@.service.
After=network-online.target

[Service]
Type=simple
User=root
Group=root
EnvironmentFile=-/etc/hco/hco.env
# Bearer token: $HCO_API_TOKEN, or the file written by `hco api token`.
ExecStart=/usr/bin/hco api-conn
StandardInput=socket
StandardOutput=socket
StandardError=journal
SyslogIdentifier=hco-api
TimeoutStopSec=15

# The container runtime needs namespaces, cgroups and mounts, so the sandbox is
# deliberately loose; the API itself only accepts authenticated requests.
NoNewPrivileges=no
PrivateTmp=no
PrivateDevices=no
ProtectSystem=no
LimitNOFILE=65536
TasksMax=8192
