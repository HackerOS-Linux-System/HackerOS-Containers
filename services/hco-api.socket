[Unit]
Description=HackerOS Containers REST API socket
Documentation=https://github.com/HackerOS-Linux-System/HackerOS-Containers

[Socket]
# Loopback only by default. Put a TLS-terminating proxy in front to expose it.
ListenStream=127.0.0.1:7443
# One service instance per connection: `hco api-conn` reads one HTTP request
# from stdin and writes the response to stdout.
Accept=yes
MaxConnections=64
SocketMode=0660

[Install]
WantedBy=sockets.target
